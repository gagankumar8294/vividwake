<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_glow">#9370DB</color>
    <color name="bg_dark">#0E0B16</color>
    <color name="card_dark">#1A1528</color>
    <color name="gold_primary">#D4AF37</color>
    <color name="gold_secondary">#F3E5AB</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0A8C0</color>
    <string name="app_name">Video Lock Screen</string>
    <string name="wallpaper_description">Plays a magical wake-up video animation every time the screen turns on and freezes smoothly on the final frame beneath your system clock.</string>
    <style name="Theme.VideoLockScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorSecondary">@color/accent_glow</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
    <style name="Theme.VideoLockScreen.Lock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>