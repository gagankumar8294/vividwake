<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16">

    <!-- Zero flicker first frame preview -->
    <ImageView
        android:id="@+id/ivFirstFramePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/first_frame" />

    <!-- Video playback layer -->
    <TextureView
        android:id="@+id/videoLockTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Subtle swipe/tap hint -->
    <TextView
        android:id="@+id/tvUnlockHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="#660E0B16"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="⚡ Swipe up or tap to unlock"
        android:textColor="#E8D5A3"
        android:textSize="14sp"
        android:fontFamily="serif" />

</FrameLayout>
