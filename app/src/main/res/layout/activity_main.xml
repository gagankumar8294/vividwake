<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock Screen Video Wallpaper"
            android:textColor="#D4AF37"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tvActiveWallpaperSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Active: Hogwarts Trio • Plays on wake, then freezes on last frame"
            android:textColor="#B0A8C0"
            android:textSize="14sp" />

        <!-- Video Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextureView
                    android:id="@+id/previewTextureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvPreviewBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="#990E0B16"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIVE PREVIEW"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Wallpaper Gallery Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Video Wallpaper Gallery"
                android:textColor="#D4AF37"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap any wallpaper to select. Live lock screen updates immediately."
                android:textColor="#B0A8C0"
                android:textSize="12sp" />

            <!-- Importing Progress Indicator -->
            <LinearLayout
                android:id="@+id/layoutImporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#261E38"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#D4AF37" />

                <TextView
                    android:id="@+id/tvImportingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Importing and optimizing video..."
                    android:textColor="#F3E8FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Horizontal Gallery RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Device Detection & Smart Action Section -->
        <TextView
            android:id="@+id/tvDeviceBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="#261E38"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="📱 Detected: Auto Detecting..."
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Primary Smart Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="✨ Apply to Lock Screen"
            android:textAllCaps="false"
            android:textColor="#0E0B16"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="#0E0B16" />

        <TextView
            android:id="@+id/tvPrimaryInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Important: In the preview, tap 'Set wallpaper' -> choose 'Home screen and lock screen'"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Brand Hand-off & Alternate Methods Section -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirectGalleryHandOff"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🎬 Direct Video Hand-off (Open in Phone Gallery)"
            android:textAllCaps="false"
            android:textColor="#F3E8FF"
            app:cornerRadius="12dp"
            app:strokeColor="#7C3AED" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLockOverride"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔄 Fix Lock Screen (Remove Old Photo Override)"
            android:textAllCaps="false"
            android:textColor="#E0D7F5"
            app:cornerRadius="12dp"
            app:strokeColor="#5B4A78" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportVideo"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📁 Choose Folder &amp; Save Video (Manual Fallback)"
            android:textAllCaps="false"
            android:textColor="#A78BFA"
            android:textSize="13sp" />

        <!-- Settings Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Behavior"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Playback Mode -->
                <RadioGroup
                    android:id="@+id/rgPlaybackMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rbFreezeLastFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#D4AF37"
                        android:checked="true"
                        android:text="Wake Animation (Play 5s, freeze on final frame)"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rbLoop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="#D4AF37"
                        android:text="Continuous Loop Animation"
                        android:textColor="#FFFFFF" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#2E2642" />

                <!-- Audio Mute Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Mute Video Audio (Silent on Lock)"
                    android:textColor="#FFFFFF"
                    app:thumbTint="#D4AF37"
                    app:trackTint="#5A4B75" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Pure Native Live Wallpaper • Zero Overlays • No Popup Delay"
            android:textColor="#665D7A"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
