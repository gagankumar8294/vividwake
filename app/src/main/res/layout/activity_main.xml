<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Section (Tap 5 times for Admin mode) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Lock Screen Video"
                android:textColor="#D4AF37"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Notification Bell Icon with Badge -->
            <FrameLayout
                android:id="@+id/btnNotificationCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_toast"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="#D4AF37" />

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_glass_toast"
                    android:backgroundTint="#FF4D6D"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- User Auth / Google Sign-In Pill -->
            <LinearLayout
                android:id="@+id/btnUserAuth"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_toast"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAuthPhoto"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

                    <TextView
                        android:id="@+id/tvUserAuthInitial"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivUserAuthIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_google" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUserAuthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sign In"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveWallpaperSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Active: Hogwarts Trio • Plays on wake, then freezes on last frame"
            android:textColor="#B0A8C0"
            android:textSize="13sp" />

        <!-- Video Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextureView
                    android:id="@+id/previewTextureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvPreviewBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="#990E0B16"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIVE PREVIEW"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Segmented Tab Switcher (My Gallery vs Explore Store) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="#1A1528"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabMyWallpapers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="My Wallpapers"
                android:textAllCaps="false"
                android:textColor="#0E0B16"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#D4AF37"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_gallery"
                app:iconTint="#0E0B16" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabExploreStore"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Explore Store"
                android:textAllCaps="false"
                android:textColor="#B0A8C0"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_store"
                app:iconTint="#B0A8C0" />
        </LinearLayout>

        <!-- Container 1: My Wallpapers Section -->
        <LinearLayout
            android:id="@+id/layoutMyWallpapers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap any wallpaper to select. Live lock screen updates immediately."
                android:textColor="#B0A8C0"
                android:textSize="12sp" />

            <!-- Importing Progress Indicator -->
            <LinearLayout
                android:id="@+id/layoutImporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#261E38"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#D4AF37" />

                <TextView
                    android:id="@+id/tvImportingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Importing and optimizing video..."
                    android:textColor="#F3E8FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Horizontal Gallery RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Container 2: Explore Store Section -->
        <LinearLayout
            android:id="@+id/layoutExploreStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStoreCatalogHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap any card to stream preview. Download to set as wallpaper."
                    android:textColor="#B0A8C0"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshStore"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="#D4AF37"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Skeleton Loading Container -->
            <LinearLayout
                android:id="@+id/layoutStoreSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/item_store_skeleton" />
                <include layout="@layout/item_store_skeleton" />
            </LinearLayout>

            <!-- Store Vertical RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStoreWallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Device Detection & Smart Action Section -->
        <TextView
            android:id="@+id/tvDeviceBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="#261E38"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="📱 Detected: Auto Detecting..."
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Primary Smart Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Apply to Lock Screen"
            android:textAllCaps="false"
            android:textColor="#0E0B16"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvPrimaryInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Important: In the preview, tap 'Set wallpaper' -> choose 'Home screen and lock screen'"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Brand Hand-off & Alternate Methods Section -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirectGalleryHandOff"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🎬 Direct Video Hand-off (Open in Phone Gallery)"
            android:textAllCaps="false"
            android:textColor="#F3E8FF"
            app:cornerRadius="12dp"
            app:strokeColor="#7C3AED" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLockOverride"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔄 Fix Lock Screen (Remove Old Photo Override)"
            android:textAllCaps="false"
            android:textColor="#E0D7F5"
            app:cornerRadius="12dp"
            app:strokeColor="#5B4A78" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportVideo"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📁 Choose Folder &amp; Save Video (Manual Fallback)"
            android:textAllCaps="false"
            android:textColor="#A78BFA"
            android:textSize="13sp" />

        <!-- Settings Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Behavior"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Playback Mode -->
                <RadioGroup
                    android:id="@+id/rgPlaybackMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rbFreezeLastFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#D4AF37"
                        android:checked="true"
                        android:text="Wake Animation (Play 5s, freeze on final frame - 0% Battery)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbLoopLockOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="#D4AF37"
                        android:text="Loop on Lock Screen Only (Freezes on Home Screen - Fast &amp; Smooth)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbLoopAlways"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="#D4AF37"
                        android:text="Loop Always (Both Lock Screen &amp; Home Screen)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#2E2642" />

                <!-- Audio Mute Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Mute Video Audio (Silent on Lock)"
                    android:textColor="#FFFFFF"
                    app:thumbTint="#D4AF37"
                    app:trackTint="#5A4B75" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Pure Native Live Wallpaper • Zero Overlays • No Popup Delay"
            android:textColor="#665D7A"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
