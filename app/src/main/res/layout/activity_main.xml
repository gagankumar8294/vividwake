<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock Screen Video Wallpaper"
            android:textColor="#D4AF37"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Plays a 5-second video on wake, then freezes on the last frame beneath your Moto system clock"
            android:textColor="#B0A8C0"
            android:textSize="14sp" />

        <!-- Video Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextureView
                    android:id="@+id/previewTextureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="#990E0B16"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIVE PREVIEW"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action: Set as Live Wallpaper -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="✨ Apply to Lock Screen"
            android:textAllCaps="false"
            android:textColor="#0E0B16"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="#0E0B16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Important: In the preview, tap 'Set wallpaper' -> choose 'Home screen and lock screen'"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLockOverride"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔄 Fix Lock Screen (If only Home Screen changed)"
            android:textAllCaps="false"
            android:textColor="#E0D7F5"
            app:strokeColor="#5B4A78"
            app:cornerRadius="12dp" />

        <!-- Settings Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Behavior"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Playback Mode -->
                <RadioGroup
                    android:id="@+id/rgPlaybackMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rbFreezeLastFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Wake Animation (Play 5s, freeze on final frame)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#D4AF37" />

                    <RadioButton
                        android:id="@+id/rbLoop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Continuous Loop Animation"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#D4AF37" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#2E2642" />

                <!-- Audio Mute Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Mute Video Audio (Silent on Lock)"
                    android:textColor="#FFFFFF"
                    app:thumbTint="#D4AF37"
                    app:trackTint="#5A4B75" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Pure Native Live Wallpaper • Zero Overlays • No Popup Delay"
            android:textColor="#665D7A"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
