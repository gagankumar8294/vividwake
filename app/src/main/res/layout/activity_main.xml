<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollViewMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="VividWake"
                android:textColor="#D4AF37"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Notification Bell Icon with Badge -->
            <FrameLayout
                android:id="@+id/btnNotificationCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_toast"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="#D4AF37" />

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_glass_toast"
                    android:backgroundTint="#FF4D6D"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- User Auth / Google Sign-In Pill -->
            <LinearLayout
                android:id="@+id/btnUserAuth"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_toast"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAuthPhoto"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

                    <TextView
                        android:id="@+id/tvUserAuthInitial"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivUserAuthIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_google" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUserAuthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sign In"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveWallpaperSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Active: Hogwarts Trio • Plays on wake, then freezes on last frame"
            android:textColor="#B0A8C0"
            android:textSize="13sp" />

        <!-- Video Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextureView
                    android:id="@+id/previewTextureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Mock Lock Screen Clock & Notification Note Overlay -->
                <LinearLayout
                    android:id="@+id/layoutLockScreenMock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:clickable="false">

                    <!-- Digital Clock -->
                    <TextClock
                        android:id="@+id/tcMockClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFF"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:fontFamily="sans-serif-light" />

                    <!-- Date & Clock Icon Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="-4dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_clock"
                            android:layout_marginEnd="6dp"
                            app:tint="#D4AF37" />

                        <TextClock
                            android:id="@+id/tcMockDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="EEE, MMM d"
                            android:format24Hour="EEE, d MMM"
                            android:textColor="#E0E0E0"
                            android:textSize="12sp"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4" />
                    </LinearLayout>

                    <!-- Slight Lock Screen Notification Note -->
                    <LinearLayout
                        android:id="@+id/layoutMockNotificationNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginHorizontal="24dp"
                        android:background="@drawable/bg_glass_toast"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_clock"
                            app:tint="#D4AF37"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvMockNotificationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VividWake • Active"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="#990E0B16"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIVE PREVIEW"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Segmented Tab Switcher (My Gallery vs Explore Store) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="#1A1528"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabMyWallpapers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="My Wallpapers"
                android:textAllCaps="false"
                android:textColor="#0E0B16"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#D4AF37"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_gallery"
                app:iconTint="#0E0B16" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabExploreStore"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Explore Store"
                android:textAllCaps="false"
                android:textColor="#B0A8C0"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_store"
                app:iconTint="#B0A8C0" />
        </LinearLayout>

        <!-- Container 1: My Wallpapers Section -->
        <LinearLayout
            android:id="@+id/layoutMyWallpapers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap any wallpaper to select. Live lock screen updates immediately."
                android:textColor="#B0A8C0"
                android:textSize="12sp" />

            <!-- Importing Progress Indicator -->
            <LinearLayout
                android:id="@+id/layoutImporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#261E38"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#D4AF37" />

                <TextView
                    android:id="@+id/tvImportingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Importing and optimizing video..."
                    android:textColor="#F3E8FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Horizontal Gallery RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Container 2: Explore Store Section -->
        <LinearLayout
            android:id="@+id/layoutExploreStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Concept 1: Unified Command Bar (Single 44dp row with smooth expansion) -->
            <LinearLayout
                android:id="@+id/layoutStoreCommandBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Search Input Container (Flexible width, expands when focused) -->
                <LinearLayout
                    android:id="@+id/layoutStoreSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_glass"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#D4AF37" />

                    <EditText
                        android:id="@+id/etStoreSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search wallpapers..."
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#7A708A"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnClearStoreSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="#D4AF37" />
                </LinearLayout>

                <!-- Gifted Filter Toggle Button (Collapses to icon-only when search is active) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterGifted"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Gifted"
                    android:textAllCaps="false"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_gift"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="#D4AF37"
                    app:backgroundTint="#261E38"
                    app:cornerRadius="10dp"
                    app:strokeColor="#50D4AF37"
                    app:strokeWidth="1.2dp" />

                <!-- Category Filter Modal Button -->
                <FrameLayout
                    android:id="@+id/btnStoreFilterCategories"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_glass"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_filter"
                        app:tint="#D4AF37" />
                </FrameLayout>
            </LinearLayout>

            <!-- Active Category Breadcrumb Banner (Clean status banner without emojis) -->
            <LinearLayout
                android:id="@+id/layoutActiveFilterBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivActiveFilterIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_gift"
                    app:tint="#D4AF37" />

                <TextView
                    android:id="@+id/tvActiveFilterText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gifted Wallpapers"
                    android:textColor="#E8E2F2"
                    android:textSize="11.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetActiveFilter"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="12dp"
                    app:iconTint="#D4AF37" />
            </LinearLayout>

            <!-- Empty Search / Filter State Layout -->
            <LinearLayout
                android:id="@+id/layoutStoreEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStoreEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No wallpapers found"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStoreEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Try another character, franchise, or reset filters."
                    android:textColor="#8E879E"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetStoreFilters"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:text="Reset Filters"
                    android:textAllCaps="false"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#D4AF37" />
            </LinearLayout>

            <!-- Skeleton Loading Container -->
            <LinearLayout
                android:id="@+id/layoutStoreSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/item_store_skeleton" />
                <include layout="@layout/item_store_skeleton" />
            </LinearLayout>

            <!-- Store Vertical RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStoreWallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Paging Loading Spinner -->
            <ProgressBar
                android:id="@+id/pbStoreLoadMore"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="#D4AF37"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Device Detection & Smart Action Section -->
        <TextView
            android:id="@+id/tvDeviceBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="#261E38"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Detected: Auto Detecting..."
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Primary Smart Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Apply to Lock Screen"
            android:textAllCaps="false"
            android:textColor="#0E0B16"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvPrimaryInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Important: In the preview, tap 'Set wallpaper' -> choose 'Home screen and lock screen'"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Brand Hand-off & Alternate Methods Section -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirectGalleryHandOff"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="14dp"
            android:text="Direct Video Hand-off (Open in Phone Gallery)"
            android:textAllCaps="false"
            android:textColor="#F3E8FF"
            android:textSize="13sp"
            android:letterSpacing="0.01"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:icon="@drawable/ic_gallery"
            app:iconTint="#C4B5FD"
            app:iconSize="18dp"
            app:iconPadding="10dp"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3D7C3AED"
            app:backgroundTint="#1F201636"
            app:rippleColor="#26FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLockOverride"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="Fix Lock Screen (Remove Old Photo Override)"
            android:textAllCaps="false"
            android:textColor="#E0D7F5"
            android:textSize="13sp"
            android:letterSpacing="0.01"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="#A78BFA"
            app:iconSize="18dp"
            app:iconPadding="10dp"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E6D5990"
            app:backgroundTint="#1A18132B"
            app:rippleColor="#26FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportVideo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="Choose Folder &amp; Save Video (Manual Fallback)"
            android:textAllCaps="false"
            android:textColor="#DDD6FE"
            android:textSize="13sp"
            android:letterSpacing="0.01"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:icon="@drawable/ic_folder"
            app:iconTint="#A78BFA"
            app:iconSize="18dp"
            app:iconPadding="10dp"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF"
            app:backgroundTint="#14FFFFFF"
            app:rippleColor="#26FFFFFF" />

        <!-- Settings Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3D3254"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Behavior"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Playback Mode -->
                <RadioGroup
                    android:id="@+id/rgPlaybackMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rbFreezeLastFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#D4AF37"
                        android:checked="true"
                        android:text="Wake Animation (Play 5s, freeze on final frame - 0% Battery)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbLoopLockOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="#D4AF37"
                        android:text="Loop on Lock Screen Only (Freezes on Home Screen - Fast &amp; Smooth)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbLoopAlways"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="#D4AF37"
                        android:text="Loop Always (Both Lock Screen &amp; Home Screen)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#2E2642" />

                <!-- Audio Mute Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Mute Video Audio (Silent on Lock)"
                    android:textColor="#FFFFFF"
                    app:thumbTint="#D4AF37"
                    app:trackTint="#5A4B75" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Pure Native Live Wallpaper • Zero Overlays • No Popup Delay"
            android:textColor="#665D7A"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
