<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStoreItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1528"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#3D3254"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Thumbnail Frame -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="130dp">

            <ImageView
                android:id="@+id/ivStoreThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1C162E"
                android:contentDescription="Wallpaper Thumbnail"
                android:scaleType="centerCrop" />

            <!-- Featured Badge -->
            <TextView
                android:id="@+id/tvStoreFeaturedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#D4AF37"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="★ STAR"
                android:textColor="#0E0B16"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Admin Hidden Badge -->
            <TextView
                android:id="@+id/tvStoreHiddenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="#B45309"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="DRAFT"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Downloaded Check Badge -->
            <TextView
                android:id="@+id/tvStoreDownloadedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="#22C55E"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Details & Actions Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStoreTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Wallpaper Title"
                android:textColor="#F3E8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStoreDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="High-quality 4K video wallpaper with loop animation."
                android:textColor="#B0A8C0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStoreSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#261E38"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="14.2 MB"
                android:textColor="#D4AF37"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Download Progress Bar -->
            <ProgressBar
                android:id="@+id/pbStoreDownload"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressTint="#D4AF37"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStoreProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Downloading 0%..."
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Download Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStoreDownload"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Download"
                    android:textAllCaps="false"
                    android:textColor="#0E0B16"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#D4AF37"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_download"
                    app:iconTint="#0E0B16" />

                <!-- Apply Button (Only when downloaded) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStoreApply"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Apply"
                    android:textAllCaps="false"
                    android:textColor="#0E0B16"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#22C55E"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_sparkle"
                    app:iconTint="#0E0B16"
                    android:visibility="gone" />

                <!-- Delete Local Download Button (Frees phone storage) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStoreDeleteLocal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#EF4444"
                    app:strokeColor="#EF4444"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
